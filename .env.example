# Four Corners — configuration.
# Copy to .env.local. Every value below has a working default: with an empty
# file the app runs entirely on local adapters, with no accounts or services.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin. Used for page metadata, the sitemap, robots.txt, absolute
# URLs in exports and the public API, and the link-preview user agent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Adapters ────────────────────────────────────────────────────────────────
# "local" runs offline out of FC_DATA_DIR. "stub" fails every call with a
# message naming the port to implement — useful to see what a feature needs.
# See docs/INTEGRATION.md.
FC_ADAPTER_DEFAULT=local
# FC_AUTH_ADAPTER=local
# FC_DATA_ADAPTER=local
# FC_BLOB_ADAPTER=local
# FC_SEARCH_ADAPTER=local
# FC_AI_ADAPTER=local
# FC_EMAIL_ADAPTER=local
# FC_RATE_LIMIT_ADAPTER=local
# FC_GEOCODER_ADAPTER=local

# Where the local adapters keep documents and uploads. Delete it to reset.
FC_DATA_DIR=.data

# Signs session cookies and blob links. Generated into .data/ when unset;
# REQUIRED in production, where the app refuses to start without it.
# FC_SESSION_SECRET=

# ── Accounts and limits ─────────────────────────────────────────────────────
# Whether anyone may create an account.
FC_SIGNUPS_ENABLED=true
# Storage plan every account gets: free (1 GB), pro (10 GB), team (50 GB),
# unlimited.
FC_DEFAULT_PLAN=free
# Override the plan's byte limit.
# FC_STORAGE_LIMIT_BYTES=
# Cap on gallery projects per account. Unset means no cap.
# FC_GALLERY_LIMIT_PER_USER=
# Lifetime of a signed link to a private file, in seconds.
FC_PRIVATE_URL_TTL_SECONDS=600

# ── Public API ──────────────────────────────────────────────────────────────
# Comma-separated keys. A caller sending one as a Bearer token gets
# 1000 requests/minute instead of 100. Empty means everyone is anonymous —
# the API still works.
# PUBLIC_API_KEYS=

# ── Features ────────────────────────────────────────────────────────────────
# Show the Explore tab to viewers.
NEXT_PUBLIC_EXPLORE_ENABLED=true
# Where exported HTML loads the Four Corners viewer from. Point it at your
# own copy to stop exports depending on a CDN.
# NEXT_PUBLIC_FC_VIEWER_CDN_BASE=https://cdn.jsdelivr.net/gh/four-corners/fourcorners.js@1.1.2/dist
